[Unit]
Description=Neuromancer Mission Control
After=network.target

[Service]
Type=simple
User=neuromancer
Group=neuromancer
WorkingDirectory=/opt/neuromancer
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/opt/neuromancer/data
# Opsional, hanya berlaku saat data/ masih kosong:
# Environment=ADMIN_EMAIL=owner@neuromancer.app
# Environment=ADMIN_PASSWORD=ganti-password-ini
ExecStart=/usr/bin/node /opt/neuromancer/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/neuromancer/data

[Install]
WantedBy=multi-user.target
